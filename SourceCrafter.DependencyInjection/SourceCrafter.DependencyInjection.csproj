<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>preview</LangVersion>	
		<PackageVersion>
			$([System.Convert]::ToUInt16(
				$([MSBuild]::Add(
					$([System.DateTime]::Now.Year),
					-2024
				))
			)).
			$([System.DateTime]::Now.ToString('yy')).
			$([System.DateTime]::Now.DayOfYear).
			$([System.Convert]::ToUInt16(
				$([MSBuild]::Divide(
					$([System.DateTime]::Now.TimeOfDay.TotalMinutes),
					15
				))
			))
		</PackageVersion>
		<Nullable>enable</Nullable>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
		<IsRoslynComponent>true</IsRoslynComponent>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<Configurations>Debug;Release;Pack;DEBUG_SG;DISG_HOST;DISG</Configurations>
		<DefineConstants>$(DefineConstants);DISG_HOST;DISG</DefineConstants>
		<IncludeBuildOutput Condition="$(Configuration) == 'Release'">false</IncludeBuildOutput>
		<Company>AsereHighDev</Company>
		<PackageOutputPath>../publish</PackageOutputPath>
		<Version>$(PackageVersion)</Version>
		<Title>Truly compile-time depedency injection</Title>
		<Description>Compile-time dependency injection library utilizing attributes to simplify and automate service registration</Description>
		<PackageProjectUrl>https://github.com/pedro-gilmora/SourceCrafter.DependencyInjection/</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/pedro-gilmora/SourceCrafter.DependencyInjection/</RepositoryUrl>
		<PackageTags>compile-time, dependency injection</PackageTags>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
	  <Optimize>True</Optimize>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; Append; native; contentfiles; analyzers; Appendtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
		<None Include="..\README.md">
		  <Pack>True</Pack>
		  <PackagePath>\</PackagePath>
		</None>
		<Compile Include="ServiceProviders.cs" />
		<Compile Include="ServiceProviders.Delegates.cs">
			<DependentUpon>ServiceProviders.cs</DependentUpon>
		</Compile>
		<Compile Include="ServiceProviders.Enums.cs">
			<DependentUpon>ServiceProviders.cs</DependentUpon>
		</Compile>
		<Compile Include="ServiceProviders.Models.cs">
			<DependentUpon>ServiceProviders.cs</DependentUpon>
		</Compile>
		<Compile Include="GlobalUsings.cs" />
		<Compile Include="Helpers.cs">
			<DependentUpon>ServiceProviders.cs</DependentUpon>
		</Compile>
		<Compile Include="ServiceProviders.Parser.cs">
			<DependentUpon>ServiceProviders.cs</DependentUpon>
		</Compile>
		<Compile Include="ServiceProviders.Renderer.cs">
			<DependentUpon>ServiceProviders.cs</DependentUpon>
		</Compile>
		<Compile Include="ServiceProviders.Emitter.cs">
			<DependentUpon>ServiceProviders.cs</DependentUpon>
		</Compile>
		<Compile Include="ServiceContainerDiagnostics.cs" />
		<!--<Compile Include="..\Solution\Utils\Map.cs">
			<Link>Utils\Map.cs</Link>
		</Compile>

		<Compile Include="..\Solution\Utils\Set.cs">
			<Link>Utils\Set.cs</Link>
		</Compile>-->
	</ItemGroup>

