<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <LangVersion>preview</LangVersion>
    <RootNamespace>Benchmarks.HandCoded</RootNamespace>
    <AssemblyName>Benchmarks.HandCoded</AssemblyName>
    <Configurations>Debug;Release;Pack;DEBUG_SG</Configurations>
    <!-- Los contenedores de la competencia generan miembros que no siempre consumimos. -->
    <NoWarn>$(NoWarn);CS9113;CS8618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
  <ItemGroup Label="Generadores contra los que se mide la version escrita a mano">
    <PackageReference Include="Jab" Version="0.12.0" PrivateAssets="all" />
    <PackageReference Include="Pure.DI" Version="2.5.3" PrivateAssets="all" />
    <PackageReference Include="CircleDI" Version="1.2.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Label="El generador propio, referenciado como analizador">
    <ProjectReference Include="..\SourceCrafter.DependencyInjection\SourceCrafter.DependencyInjection.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" UndefineProperties="TargetFramework" />
    <ProjectReference Include="..\SourceCrafter.DependencyInjection.Metadata\SourceCrafter.DependencyInjection.Metadata.csproj" />
  </ItemGroup>
</Project>
