<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>preview</LangVersion>
		<Nullable>enable</Nullable>
		<DefineConstants>$(DefineConstants);DISG_META</DefineConstants>
		<Company>AsereHighDev</Company>
		<PackageOutputPath>../packaging</PackageOutputPath>
		<Version>1.25.211.107</Version>
		<Title>Truly compile-time depedency injection metadata</Title>
		<Description>Attributes for compile-time dependency injection library utilizing attributes to simplify and automate service registration</Description>
		<PackageProjectUrl>https://github.com/pedro-gilmora/SourceCrafter.DependencyInjection/</PackageProjectUrl>
		<RepositoryUrl>https://github.com/pedro-gilmora/SourceCrafter.DependencyInjection/</RepositoryUrl>
		<PackageTags>compile-time metadata, dependency injection</PackageTags>
  </PropertyGroup>
	<ItemGroup>
		<Compile Include="..\Solution\Metadata\*.cs">
			<Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
		</Compile>
	</ItemGroup>
</Project>
